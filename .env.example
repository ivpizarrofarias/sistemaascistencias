# Copiar a .env y rellenar los valores secretos.
# NUNCA subir .env a GitHub.

# Puertos expuestos en el host
HTTP_PORT=8081
BACKEND_PORT=8080
MYSQL_HOST_PORT=3307

# MySQL dentro de Docker Compose
MYSQL_ROOT_PASSWORD=cambiar_password_root_mysql
MYSQL_DATABASE=sistema_asis
MYSQL_USER=dev
MYSQL_PASSWORD=cambiar_password_mysql

# El backend se conecta al servicio "mysql" por la red interna de Compose.
DB_URL="jdbc:mysql://mysql:3306/sistema_asis?useUnicode=true&characterEncoding=UTF-8&serverTimezone=America/Santiago"
DB_USERNAME=dev
DB_PASSWORD=cambiar_password_mysql
DB_INIT_TIMEOUT=120000
JPA_DDL_AUTO=update

# Seguridad JWT (mínimo 48 caracteres para HS384)
JWT_SECRET=cambiar_este_valor_por_un_secreto_aleatorio_de_al_menos_48_caracteres
JWT_EXPIRATION_MS=86400000

# Usuario administrador inicial
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar_password_admin

# Datos de la empresa en liquidaciones/PDF
COMPANY_NAME="IPFSoft SpA"
COMPANY_RUT=76.123.456-7

# CORS: incluir la URL desde la que se abre la app, aunque nginx haga de proxy.
# Chrome envía la cabecera Origin en las peticiones POST y Spring la valida.
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
